# UI
AERA_SCREEN_H := 2400
AERA_STATUS_H := 108
AERA_STATUS_INDENT_LEFT := 54
AERA_STATUS_INDENT_RIGHT := 24
AERA_HIDE_NOTCH := 1
AERA_CLOCK_POS := 1
AERA_USE_GREEN_LED := 0
AERA_ALLOW_DISABLE_NAVBAR := 0
AERA_USE_LOCKSCREEN_BUTTON := 1

# Data / Metadata
AERA_ENABLE_ALL_PARTITION_TOOLS := 1
AERA_WIPE_METADATA_AFTER_DATAFORMAT := 1
AERA_FORCE_CASEFOLDING := 1
AERA_DEFAULT_KEYMASTER_VERSION := 4.1
AERA_DYNAMIC_FULL_SIZE := 6710886400
AERA_REDUCE_DECRYPTION_TIMEOUT := 1
AERA_QUICK_BACKUP_LIST := /data;/boot;

# Tools
AERA_ENABLE_LPTOOLS := 1

# OTA
AERA_DISABLE_ORS_AUTO_REBOOT := 1
AERA_DISABLE_OTA_MENU := 1

# Security
AERA_ADVANCED_SECURITY := 0

# lz4 compression
AERA_USE_LZ4_COMPRESSION := 1

# Don't spam the console with loop errors
AERA_LOOP_DEVICE_ERRORS_TO_LOG := 1
AERA_DONT_KEEP_LOG_HISTORY := 1

# Timezone
AERA_DEFAULT_TIMEZONE := CET-1CEST,M3.5.0,M10.5.0/3

# Flashlight
AERA_FLASHLIGHT_ENABLE := 0

# Maintainer
AERA_MAINTAINER := @medusa659||YamaMoto

# WLAN
AERA_ENABLE_WLAN := 1
